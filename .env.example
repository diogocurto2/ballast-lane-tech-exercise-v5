# Copy this file to .env and replace every placeholder before running docker compose.
# .env is git-ignored; never commit real values.

# PostgreSQL superuser password for the local container.
POSTGRES_PASSWORD=change-me-local-only

# Connection string used by the migrator and both API hosts inside the compose network.
# Host "postgres" is the compose service name; port 5432 is the container port.
ConnectionStrings__Database=Host=postgres;Port=5432;Database=taskmanager;Username=postgres;Password=change-me-local-only

# Connection string used by integration and HTTP tests run from the host machine.
ConnectionStrings__TestDatabase=Host=localhost;Port=5432;Database=taskmanager_test;Username=postgres;Password=change-me-local-only

# HMAC signing key for JWT bearer tokens. Use a long random value locally; never reuse a real secret.
Jwt__SigningKey=change-me-local-only-signing-key-at-least-32-bytes

# Origin allowed by CORS on both API hosts (the Vite development server).
FrontendOrigin=http://localhost:5173
